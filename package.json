{
  "name": "@dreamariner/dsh-chat-search",
  "description": "Time-window chat transcript search over DSH session history",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsdown",
    "dev:hmr": "dsh-ctl dev-hmr",
    "profile:add": "dsh-ctl profile-add",
    "dsh:start": "dsh-ctl start",
    "dsh:restart": "dsh-ctl restart",
    "dsh:stop": "dsh-ctl stop",
    "dsh:status": "dsh-ctl status",
    "dsh:probe": "dsh-ctl probe",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-chat-search"
  ],
  "license": "Apache-2.0",
  "author": "Jianan",
  "homepage": "https://github.com/dreamariner/dsh-chat-search",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamariner/dsh-chat-search"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.19.0 <4.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@dreamariner/dsh-ctl": "^0.6.0",
    "@types/node": "^24",
    "js-yaml": "^4.1.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.7.0",
  "dshVersion": "0.2.2-rc.5"
}
