{
  "name": "@dreamariner/dsh-chat-search",
  "description": "Time-window chat transcript search over DSH session history",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsdown",
    "dev:hmr": "node scripts/dev-hmr.mjs",
    "profile:add": "node scripts/profile-add.mjs",
    "dsh:start": "node scripts/dsh-ctl.mjs start",
    "dsh:restart": "node scripts/dsh-ctl.mjs restart",
    "dsh:stop": "node scripts/dsh-ctl.mjs stop",
    "dsh:status": "node scripts/dsh-ctl.mjs status",
    "dsh:probe": "node scripts/dsh-ctl.mjs probe",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-chat-search"
  ],
  "license": "Apache-2.0",
  "author": "Jianan",
  "homepage": "https://github.com/dreamariner/dsh-chat-search",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamariner/dsh-chat-search"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0-0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "js-yaml": "^4.1.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9",
    "vitest": "^5.0.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "packageManager": "pnpm@11.7.0"
}
